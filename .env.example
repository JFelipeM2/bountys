# ============================================================
# Asset Sentinel - Variables de Entorno (.env.example)
# ============================================================
# Copia este archivo como .env y rellena los valores reales:
#   cp .env.example .env
# NUNCA subas el archivo .env a un repositorio publico.
# ============================================================

# --- Google Gemini API ---
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- Telegram Bot ---
# Crear un bot con @BotFather en Telegram
# El token tiene el formato: 1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# --- Telegram Chat ID ---
# Para un chat privado: tu user ID (obtenlo con @userinfobot)
# Para un canal/grupo: -100XXXXXXXXXX
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# --- Configuracion de Escaneo ---
# Intervalo entre ciclos completos de escaneo (en horas)
# Minimo recomendado: 4 horas. Por defecto: 6 horas.
SCAN_INTERVAL_HOURS=6

# Severidades de Nuclei a reportar (separadas por coma, sin espacios)
# Opciones: info, low, medium, high, critical
NUCLEI_SEVERITY=medium,high,critical

# Codigos HTTP considerados como "host activo" por httpx
HTTPX_STATUS_CODES=200,301,302,403

# Timeout maximo en segundos por subproceso (subfinder/httpx/nuclei)
SUBPROCESS_TIMEOUT=300
